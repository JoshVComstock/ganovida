# ─────────────────────────────────────────────────────────────
#  GanoVida — variables de entorno
#  Copia este archivo como .env.local y completa los valores.
#  En Vercel: Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# URL canónica del sitio (SIN barra final). Se usa para SEO:
# canonical, Open Graph, sitemap.xml y robots.txt.
# En producción debe ser el dominio final, no el de vercel.app.
NEXT_PUBLIC_SITE_URL=https://ganovida.shop

# WhatsApp de pedidos, en formato internacional sin + ni espacios.
# Bolivia = 591. Ej: 591 + 65323871
NEXT_PUBLIC_WHATSAPP_NUMBER=59165323871

# Tu código de patrocinador DXN (para el alta de afiliados en eWorld).
NEXT_PUBLIC_SPONSOR_CODE=DXN000000

# Redes sociales (URL completa).
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/ganovida.bo
NEXT_PUBLIC_TIKTOK=https://tiktok.com/@ganovida.bo
